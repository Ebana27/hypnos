# ============================================================
# Fichier d'exemple des variables d'environnement Hypnos.
# Copier en `.env` puis remplir :   cp .env.example .env
# Le fichier `.env` est ignore par git (voir .gitignore).
# En CI, ces variables sont injectees par le workflow, pas par ce fichier.
# ============================================================

# --- Cle secrete (OBLIGATOIRE en production) ---
# Genere avec : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Ne JAMAIS committer la vraie valeur.
SECRET_KEY=django-insecure-changez-moi-avant-de-mettre-en-production

# --- Mode developpement ---
# Mettre à 0 en production. Le code force aussi DEBUG=False dès que la
# variable CI est définie par GitHub Actions, donc impossible d'activer
# DEBUG par accident sur une PR.
DEBUG=1

# --- Domaines autorisés, séparés par des virgules ---
# Ignoré tant que DEBUG=1 (Django autorise alors localhost).
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Jeton de démarrage ---
# Ouvre UNE seule fois la création du premier compte sur POST /api/users/,
# à partir du moment où la table des comptes est vide. Ce compte est le
# propriétaire de la plateforme (superadmin, sans hôtel) : c'est lui qui crée
# ensuite les hôtels et leurs agents.
#
#   curl -X POST /api/users/ -H "X-Bootstrap-Token: <ce jeton>" \
#        -d '{"username":"...","email":"...","password":"..."}'
#
# La porte se referme dès qu'un compte existe. Laissez la valeur vide, et le
# premier compte devra être créé autrement : c'est volontaire, un oubli de
# déploiement ne doit pas ouvrir la création d'un superadmin à quiconque
# joint le serveur.
BOOTSTRAP_TOKEN=

# --- Page 404 personnalisée ---
# 1 (défaut) : /route-inexistante affiche la page 404.html du projet, même
#     avec DEBUG=1. Django, lui, n'affiche que sa page technique listant les
#     motifs testés : le middleware main.middleware.CustomNotFoundMiddleware
#     prend le relais.
# 0 : on rend la main à Django, pratique quand on écrit une URL et qu'on veut
#     la liste des motifs acceptés.
CUSTOM_404_IN_DEBUG=1

# --- Base de données ---
# Laissez vide en développement (SQLite local).
# En production, typiquement postgresql://user:mdp@host:5432/hypnos
DATABASE_URL=

# --- E-mails ---
# console = affiche dans le terminal, aucun envoi reel.
# smtp = envoi reel, needs a real host/user/password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@hypnos.dev

# --- django-allauth ---
# optional  = pas d'email de confirmation (developpement)
# mandatory = confirmation obligatoire avant connexion (production)
ACCOUNT_EMAIL_VERIFICATION=optional

# --- KPay-NOW (sandbox par défaut; ne collez jamais ces secrets dans Git) ---
# Récupérer des clés kpay_test_... dans le dashboard KPay.
KPAY_API_KEY=
KPAY_SECRET_KEY=
# Secret HMAC pour le callback webhook et secret HMAC distinct pour le retour du checkout.
KPAY_WEBHOOK_SECRET=
KPAY_GATEWAY_SECRET=
# Host API officiel KPay; l'URL publique est l'origine HTTPS de votre API Hypnos.
KPAY_BASE_URL=https://admin.kpay.site
KPAY_PUBLIC_BASE_URL=https://dorinda-starlike-blackheartedly.ngrok-free.dev
# Rester à 0 pour les essais. Une clé kpay_live_... est rejetée sans opt-in explicite.
KPAY_ALLOW_LIVE_PAYMENTS=0
KPAY_TIMEOUT_SECONDS=15
