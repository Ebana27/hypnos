        </mxCell>
        <mxCell id="mcd_16" value="&lt;b&gt;TYPE DE CHAMBRE&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;id_type&lt;br&gt;label&lt;br&gt;prix&lt;br&gt;capacite" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="50" y="350" width="225" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_17" value="&lt;b&gt;CHAMBRE&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;id_chambre&lt;br&gt;numero&lt;br&gt;etage&lt;br&gt;statut&lt;br&gt;→ HOTEL&lt;br&gt;→ TYPE DE CHAMBRE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="310" y="350" width="235" height="142" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_18" value="&lt;b&gt;UTILISATEUR (compte)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;id_user&lt;br&gt;username&lt;br&gt;email&lt;br&gt;password&lt;br&gt;role&lt;br&gt;→ HOTEL&lt;br&gt;(+ herite AbstractUser)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="310" y="130" width="235" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_19" value="&lt;b&gt;PERSONNEL&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;matricule&lt;br&gt;nom&lt;br&gt;prenom&lt;br&gt;sexe&lt;br&gt;poste&lt;br&gt;→ UTILISATEUR&lt;br&gt;→ HOTEL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="580" y="130" width="225" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_20" value="&lt;b&gt;NOTIFICATION&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;id_notif&lt;br&gt;title&lt;br&gt;detail&lt;br&gt;action&lt;br&gt;lu&lt;br&gt;created_at&lt;br&gt;→ UTILISATEUR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="580" y="350" width="225" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_21" value="&lt;b&gt;CLIENT&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;id_client&lt;br&gt;nom&lt;br&gt;prenom&lt;br&gt;tel&lt;br&gt;email&lt;br&gt;document&lt;br&gt;preference&lt;br&gt;sexe&lt;br&gt;loyalty&lt;br&gt;&lt;i&gt;pas de mot de passe&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="50" y="560" width="225" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_22" value="&lt;b&gt;RESERVATION&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;num&lt;br&gt;date_debut&lt;br&gt;date_fin&lt;br&gt;statut&lt;br&gt;nombreDePersonne&lt;br&gt;date_decision&lt;br&gt;motif_refus&lt;br&gt;→ HOTEL&lt;br&gt;→ CLIENT&lt;br&gt;→ CHAMBRE (attribuee)&lt;br&gt;→ CHAMBRE (demandee)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="310" y="560" width="300" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_23" value="&lt;b&gt;CURSEUR DE SYNCHRO&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;appareil&lt;br&gt;derniere_consultation&lt;br&gt;nombre_appels&lt;br&gt;mis_a_jour&lt;br&gt;→ HOTEL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="850" y="155" width="245" height="142" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_24" value="&lt;b&gt;JOURNAL DE SYNCHRO&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────────&lt;/font&gt;&lt;br&gt;appareil&lt;br&gt;action&lt;br&gt;succes&lt;br&gt;detail&lt;br&gt;horodatage&lt;br&gt;→ HOTEL&lt;br&gt;→ RESERVATION" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="mcd_1">
          <mxGeometry x="850" y="355" width="245" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_25" value="&lt;b&gt;&lt;font size='13'&gt;A lire&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CLIENT n'est pas un compte.&lt;/b&gt; C'est une fiche saisie a chaque reservation : pas de mot de passe, pas de connexion. Seul UTILISATEUR peut se connecter.&lt;br&gt;&lt;br&gt;&lt;b&gt;Une RESERVATION a trois liens vers HOTEL et CHAMBRE.&lt;/b&gt; Elle appartient a un hotel, porte une chambre attribuee (vide tant que l'agent n'a pas repondu) et garde la chambre que le client avait demandee, meme si l'agent en attribue une autre.&lt;br&gt;&lt;br&gt;&lt;b&gt;UTILISATEUR peut avoir 0 ou 1 PERSONNEL.&lt;/b&gt; Inversement, un employe peut travailler sans compte technique.&lt;br&gt;&lt;br&gt;&lt;b&gt;Les 2 tables du cadre violet sont techniques.&lt;/b&gt; Elles ne decrivent pas l'activite hoteliere : elles servent uniquement a la synchronisation avec le logiciel desktop." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="mcd_1">
          <mxGeometry x="850" y="610" width="630" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="mcd_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;fontColor=#6c8ebf;labelBackgroundColor=#ffffff;" edge="1" parent="mcd_1" source="mcd_15" target="mcd_17">
