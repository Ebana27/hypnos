  <diagram id="mpd" name="2 - MPD (tables, PK, FK, contraintes)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="mpd_0"/>
        <mxCell id="mpd_1" parent="mpd_0"/>
        <mxCell id="mpd_11" value="Hypnos &amp;mdash; Modele Physique de Donnees" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="mpd_1">
          <mxGeometry x="40" y="20" width="1100" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_12" value="Exactement ce que Django a cree dans la base. &lt;b&gt;PK&lt;/b&gt; = cle primaire, &lt;b&gt;FK&lt;/b&gt; = cle etrangere, &lt;b&gt;UQ&lt;/b&gt; = unique. Le nom de table est entre parentheses." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;" vertex="1" parent="mpd_1">
          <mxGeometry x="40" y="56" width="1900" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_13" value="&lt;b&gt;HOTEL  (hotel)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  hotel_id          integer auto&lt;br&gt;    name             varchar(150)&lt;br&gt;    adresse          varchar(255)&lt;br&gt;    ville            varchar(100)&lt;br&gt;    tel              varchar(30)&lt;br&gt;    email            varchar(255)&lt;br&gt;    nombre_etages    integer  &amp;gt;= 1&lt;br&gt;    nombre_chambres  integer  &amp;gt;= 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="50" y="110" width="315" height="162" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_14" value="&lt;b&gt;TYPE_DE_CHAMBRE  (type_de_chambre)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  id_type          integer auto&lt;br&gt;UQ  label            varchar(100)&lt;br&gt;    prix            decimal(10,2) &amp;gt;= 0&lt;br&gt;    capacite        integer  &amp;gt;= 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="50" y="298" width="315" height="102" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_15" value="&lt;b&gt;USER  (user)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  id_user          integer auto&lt;br&gt;UQ  username         varchar(150)&lt;br&gt;UQ  email            varchar(255)&lt;br&gt;    password         varchar(255)  hache&lt;br&gt;    role             varchar(30)&lt;br&gt;                         admin|receptionniste|manager&lt;br&gt;FK  hotel_id         &amp;rarr; hotel.hotel_id   NULL&lt;br&gt;    (PROTECT, 0,1 : admin plateforme)&lt;br&gt;  + herite de AbstractUser :&lt;br&gt;    is_superuser, is_staff, is_active,&lt;br&gt;    last_login, date_joined, first_name,&lt;br&gt;    last_name, groups, user_permissions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="50" y="426" width="315" height="222" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_16" value="&lt;b&gt;CHAMBRE  (chambre)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  id_chambre       integer auto&lt;br&gt;FK  hotel_id         &amp;rarr; hotel.hotel_id   NOT NULL&lt;br&gt;    (CASCADE)&lt;br&gt;FK  id_type          &amp;rarr; type_de_chambre.id_type&lt;br&gt;                         NOT NULL (PROTECT)&lt;br&gt;    numero           varchar(20)&lt;br&gt;    etage            integer  &amp;gt;= 0&lt;br&gt;    statut           varchar(20) defaut 'disponible'&lt;br&gt;UQ  (hotel_id, numero)&lt;br&gt;IDX (hotel_id, statut)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="420" y="110" width="315" height="192" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_17" value="&lt;b&gt;PERSONNEL  (personnel)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  matricule        integer auto&lt;br&gt;FK  id_user          &amp;rarr; user.id_user     NULL&lt;br&gt;    (SET_NULL, relation 1-1 optionnelle)&lt;br&gt;FK  hotel_id         &amp;rarr; hotel.hotel_id   NOT NULL&lt;br&gt;    (CASCADE)&lt;br&gt;    nom              varchar(100)&lt;br&gt;    prenom           varchar(100)&lt;br&gt;    sexe             char(1)  M|F&lt;br&gt;    poste            varchar(100)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="420" y="328" width="315" height="177" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_18" value="&lt;b&gt;CLIENT  (client)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  id_client        integer auto&lt;br&gt;    nom              varchar(100)&lt;br&gt;    prenom           varchar(100)&lt;br&gt;    tel              varchar(30)&lt;br&gt;    email            varchar(255)&lt;br&gt;                         indexe, NON unique&lt;br&gt;    document         varchar(255) vide ok&lt;br&gt;    preference       varchar(255) vide ok&lt;br&gt;    sexe             char(1)  M|F&lt;br&gt;    loyalty          boolean  defaut false&lt;br&gt;IDX (nom, prenom)&lt;br&gt;  &lt;i&gt;aucun password : ne se connecte pas&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="420" y="531" width="315" height="222" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_19" value="&lt;b&gt;RESERVATION  (reservation)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  num              integer auto&lt;br&gt;FK  hotel_id         &amp;rarr; hotel.hotel_id   NOT NULL&lt;br&gt;    (PROTECT)&lt;br&gt;FK  id_client        &amp;rarr; client.id_client NOT NULL&lt;br&gt;    (PROTECT)&lt;br&gt;FK  id_chambre       &amp;rarr; chambre.id_chambre  NULL&lt;br&gt;    (PROTECT) vide = pseudo-reservation&lt;br&gt;FK  chambre_demandee_id&lt;br&gt;                    &amp;rarr; chambre.id_chambre  NULL&lt;br&gt;    (SET_NULL) choix du client&lt;br&gt;    date_debut       date   NOT NULL&lt;br&gt;    date_fin         date   NOT NULL&lt;br&gt;    statut           varchar(20)&lt;br&gt;                         defaut 'en_attente'&lt;br&gt;    nombreDePersonne integer  &amp;gt;= 1&lt;br&gt;    date_decision    timestamp  NULL&lt;br&gt;    motif_refus      varchar(255) vide ok&lt;br&gt;    created_at       timestamp  defaut now&lt;br&gt;    updated_at       timestamp  auto&lt;br&gt;IDX (statut, date_debut)&lt;br&gt;IDX (date_debut, date_fin)&lt;br&gt;  &lt;i&gt;tri par defaut : -date_debut&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="790" y="110" width="365" height="372" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_20" value="&lt;b&gt;NOTIFICATION  (notification)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  id_notif         integer auto&lt;br&gt;FK  id_user          &amp;rarr; user.id_user  NOT NULL&lt;br&gt;    (CASCADE)&lt;br&gt;    title            varchar(150)&lt;br&gt;    detail           text&lt;br&gt;    action           varchar(150) vide ok&lt;br&gt;    lu               boolean  defaut false&lt;br&gt;    created_at       timestamp  auto_now_add&lt;br&gt;IDX (id_user, lu)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="790" y="508" width="365" height="177" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_21" value="&lt;b&gt;SYNC_CURSOR  (sync_cursor)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  id               integer auto&lt;br&gt;FK  hotel_id         &amp;rarr; hotel.hotel_id  NOT NULL&lt;br&gt;    appareil         varchar(64)&lt;br&gt;    derniere_consultation  timestamp  NULL&lt;br&gt;    nombre_appels     integer  defaut 0&lt;br&gt;    mis_a_jour        timestamp  auto&lt;br&gt;UQ (hotel_id, appareil)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="1200" y="110" width="300" height="147" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_22" value="&lt;b&gt;SYNC_JOURNAL  (sync_journal)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;──────&lt;/font&gt;&lt;br&gt;PK  id               integer auto&lt;br&gt;FK  hotel_id         &amp;rarr; hotel.hotel_id  NOT NULL&lt;br&gt;FK  num              &amp;rarr; reservation.num NOT NULL&lt;br&gt;    appareil         varchar(64) vide ok&lt;br&gt;    action           varchar(40)&lt;br&gt;    succes           boolean  defaut true&lt;br&gt;    detail           text  vide ok&lt;br&gt;    horodatage       timestamp  auto_now_add&lt;br&gt;IDX (hotel_id, horodatage)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="1200" y="283" width="300" height="177" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_23" value="&lt;b&gt;&lt;font size='12'&gt;Regles appliquees 2 fois&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chaque regle existe en &lt;b&gt;CheckConstraint&lt;/b&gt; (garantie par la base, meme en INSERT SQL brut) &lt;b&gt;et&lt;/b&gt; en &lt;b&gt;clean()&lt;/b&gt; (message lisible, appele par save() et par les serializers DRF).&lt;br&gt;&lt;br&gt;&lt;b&gt;reservation_fin_apres_debut&lt;/b&gt; &amp;mdash; fin &amp;gt; debut&lt;br&gt;&lt;b&gt;reservation_min_une_personne&lt;/b&gt; &amp;mdash; nombreDePersonne &amp;ge; 1&lt;br&gt;&lt;b&gt;reservation_confirmee_avec_chambre&lt;/b&gt; &amp;mdash; si statut est confirmee ou terminee, alors chambre n'est pas NULL&lt;br&gt;&lt;br&gt;&lt;b&gt;chambre etage &amp;le; hotel nombre_etages&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pas de double reservation&lt;/b&gt; sur la meme chambre : les intervalles [debut, fin] ne peuvent se chevaucher que si les deux reservations sont actives." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="mpd_1">
          <mxGeometry x="1200" y="486" width="300" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_24" value="&lt;b&gt;&lt;font size='13'&gt;Sens des suppressions&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CASCADE&lt;/b&gt; &amp;mdash; l'entite fille disparait avec la mere.&lt;br&gt;&amp;nbsp;&amp;nbsp;chambre, personnel, notification, journal&lt;br&gt;&lt;br&gt;&lt;b&gt;PROTECT&lt;/b&gt; &amp;mdash; suppression &lt;b&gt;refusee&lt;/b&gt; tant qu'il reste une reference. protege l'historique et les reservations.&lt;br&gt;&amp;nbsp;&amp;nbsp;user, chambre attribuee, client, hotel, reservation&lt;br&gt;&lt;br&gt;&lt;b&gt;SET_NULL&lt;/b&gt; &amp;mdash; la FK passe a NULL, la ligne survit.&lt;br&gt;&amp;nbsp;&amp;nbsp;chambre demandee, fiche personnel&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font size='13'&gt;Les 2 bases&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Toutes ces tables sont dans &lt;b&gt;DATABASE 1&lt;/b&gt; (cote API, la source de verite).&lt;br&gt;&lt;br&gt;&lt;b&gt;DATABASE 2&lt;/b&gt; (locale, cote logiciel desktop) ne contient que le cache de la file d'attente. Aucune de ces tables n'y existe." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="mpd_1">
          <mxGeometry x="1540" y="110" width="480" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_25" value="&lt;b&gt;&lt;font size='13'&gt;3 pieges a connaître&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. La table s'appelle &lt;code&gt;user&lt;/code&gt;&lt;/b&gt; &amp;mdash; un mot reserve en PostgreSQL. Ca marche en SQLite (developpement) mais devra etre guillemet ou renomme au passage sur alwaysdata.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. nombre_chambres est trompeur&lt;/b&gt; &amp;mdash; c'est une valeur saisie a la creation de l'hotel, pas un calcul. Pour le vrai nombre, utiliser &lt;code&gt;Hotel.chambres.count()&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. &lt;code&gt;User.hotel&lt;/code&gt; et &lt;code&gt;Personnel.hotel&lt;/code&gt; peuvent se contredire.&lt;/b&gt; Rien ne verifie aujourd'hui qu'un compte et sa fiche personnel apontent vers le meme hotel. Meme probleme entre &lt;code&gt;Reservation.hotel&lt;/code&gt; et sa chambre. A corriger." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="mpd_1">
          <mxGeometry x="1540" y="615" width="480" height="375" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;startArrow=ERone;startFill=0;endArrow=ERone;endFill=0;fontSize=10;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="mpd_1" source="mpd_13" target="mpd_16">
