        <mxCell id="27" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=20;" value="GET /api/sync/demandes/  —  avec son JWT" vertex="1">
