        <mxCell id="21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" value="ÉCRITURE dans DATABASE 1&lt;br&gt;une Demande est créée, sans chambre attribuée" vertex="1">
