        </mxCell>
        <mxCell id="42" edge="1" parent="1" source="31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=blockThin;endFill=1;" target="33" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="43" edge="1" parent="1" source="33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=blockThin;endFill=1;" target="35" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="44" edge="1" parent="1" source="35" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=blockThin;endFill=1;" target="37" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="45" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;DATABASE 2&lt;br&gt;cache local du poste&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="200" x="1150" y="660" as="geometry" />
        </mxCell>
        <mxCell id="46" edge="1" parent="1" source="31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;" target="45" value="JSON reçu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="47" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;" value="&lt;b&gt;&lt;font size=&#39;14&#39;&gt;Ce que cette synchronisation n&#39;est PAS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ce n&#39;est pas une réplication bidirectionnelle.&lt;/b&gt; Le poste n&#39;envoie jamais ses données métier vers l&#39;API : il n&#39;envoie qu&#39;une décision. Il n&#39;y a donc &lt;b&gt;aucun conflit d&#39;écriture&lt;/b&gt; à résoudre, et aucun champ « date de synchronisation » à comparer entre les deux bases.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ce n&#39;est pas une base à jour.&lt;/b&gt; DATABASE 2 ne contient que la file d&#39;attente telle qu&#39;elle était au dernier appel. Si le réseau tombe, l&#39;agent voit une file périmée — et la confirmation refusée au retour le lui dira.&lt;br&gt;&lt;br&gt;&lt;b&gt;Le sens des écritures est unique :&lt;/b&gt; seul le serveur écrit dans DATABASE 1. Le logiciel local ne fait que lire, sauf la décision de l&#39;agent." vertex="1">
          <mxGeometry height="175" width="1240" x="120" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;" value="&lt;b&gt;&lt;font size=&#39;14&#39;&gt;Ce qui est déjà écrit dans le code&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ Modèles &lt;b&gt;User.hotel&lt;/b&gt; (nullable, constraint &lt;b&gt;user_hotel_ou_superuser&lt;/b&gt;), &lt;b&gt;Personnel.user&lt;/b&gt; (sans nom ni hotel), &lt;b&gt;Client&lt;/b&gt;, &lt;b&gt;Demande&lt;/b&gt;, &lt;b&gt;Reservation&lt;/b&gt; (chambre NOT NULL), &lt;b&gt;SyncCursor&lt;/b&gt;, &lt;b&gt;JournalSync.demande&lt;/b&gt;&lt;br&gt;✅ Logique métier testée dans &lt;b&gt;sync/services.py&lt;/b&gt; — disponibilité, file d&#39;attente, validation atomique (80 tests verts au total)&lt;br&gt;⬜ Les points d&#39;entrée HTTP ci-dessus &lt;b&gt;ne sont pas encore écrits&lt;/b&gt; (ni en Python ni en JavaScript) : ce schéma décrit la cible, pas l&#39;état actuel." vertex="1">
          <mxGeometry height="175" width="1240" x="120" y="1255" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
