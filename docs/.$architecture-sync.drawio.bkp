        <mxCell id="28" parent="1" style="text;html=1;fontSize=11;align=left;fontColor=#6b6b6b;verticalAlign=middle;" value="Un GET ne modifie rien,&lt;br&gt;quel que soit le nombre de fois&lt;br&gt;où tu le rappelles." vertex="1">
          <mxGeometry height="46" width="340" x="760" y="528" as="geometry" />
        </mxCell>
        <mxCell id="29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" value="l&#39;API lit la file : statut = en_attente,&lt;br&gt;et l&#39;hôtel du compte connecté" vertex="1">
          <mxGeometry height="58" width="520" x="180" y="604" as="geometry" />
        </mxCell>
        <mxCell id="30" parent="1" style="text;html=1;fontSize=11;align=left;fontColor=#6b6b6b;verticalAlign=middle;" value="Filtré sur l&#39;hôtel : un agent&lt;br&gt;de l&#39;hôtel A ne voit jamais&lt;br&gt;la file de l&#39;hôtel B." vertex="1">
          <mxGeometry height="58" width="340" x="760" y="604" as="geometry" />
        </mxCell>
        <mxCell id="31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" value="RÉPONSE JSON — la file d&#39;attente" vertex="1">
          <mxGeometry height="46" width="520" x="180" y="692" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="text;html=1;fontSize=11;align=left;fontColor=#6b6b6b;verticalAlign=middle;" value="Le poste garde ça en mémoire&lt;br&gt;pour ne pas re-demander à chaque fois." vertex="1">
          <mxGeometry height="46" width="340" x="760" y="692" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=20;" value="GET /api/sync/demandes/&amp;lt;n&amp;gt;/propositions/&lt;br&gt;les 3 chambres libres les moins chères" vertex="1">
          <mxGeometry height="58" width="520" x="180" y="768" as="geometry" />
        </mxCell>
        <mxCell id="34" parent="1" style="text;html=1;fontSize=11;align=left;fontColor=#6b6b6b;verticalAlign=middle;" value="Si la chambre demandée est libre,&lt;br&gt;elle fait partie des propositions." vertex="1">
          <mxGeometry height="58" width="340" x="760" y="768" as="geometry" />
        </mxCell>
        <mxCell id="35" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=20;" value="POST /api/sync/demandes/&amp;lt;n&amp;gt;/valider/&lt;br&gt;l&#39;agent confirme une chambre, ou refuse avec un motif" vertex="1">
          <mxGeometry height="58" width="520" x="180" y="856" as="geometry" />
        </mxCell>
        <mxCell id="36" parent="1" style="text;html=1;fontSize=11;align=left;fontColor=#6b6b6b;verticalAlign=middle;" value="Le poste envoie une décision,&lt;br&gt;pas des données métier." vertex="1">
          <mxGeometry height="58" width="340" x="760" y="856" as="geometry" />
        </mxCell>
        <mxCell id="37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" value="ÉCRITURE dans DATABASE 1&lt;br&gt;une Reservation est créée (chambre obligatoire) et contact@hotel.cg envoie un mail, ou par whatsapp ou par SMS&lt;br&gt;ou la Demande passe à refusée — dans ce cas&lt;br&gt;aucune Reservation n&#39;est écrite" vertex="1">
          <mxGeometry height="86" width="520" x="180" y="944" as="geometry" />
        </mxCell>
        <mxCell id="38" parent="1" style="text;html=1;fontSize=11;align=left;fontColor=#6b6b6b;verticalAlign=middle;" value="L&#39;API refuse si la chambre a été&lt;br&gt;prise entre-temps ; la demande&lt;br&gt;reste alors en attente." vertex="1">
          <mxGeometry height="58" width="340" x="760" y="944" as="geometry" />
        </mxCell>
        <mxCell id="39" edge="1" parent="1" source="26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=blockThin;endFill=1;" target="27" value="">
