        <mxCell id="mcd_17" value="&lt;b&gt;CHAMBRE&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;id_chambre&lt;br&gt;numero&lt;br&gt;etage&lt;br&gt;statut&lt;br&gt;â†’ HOTEL&lt;br&gt;â†’ TYPE DE CHAMBRE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mcd_1">
