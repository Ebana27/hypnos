  <diagram id="mpd" name="2 - MPD (tables, PK, FK, contraintes)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="mpd_0"/>
        <mxCell id="mpd_1" parent="mpd_0"/>
        <mxCell id="mpd_11" value="Hypnos &amp;mdash; Modele Physique de Donnees" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="mpd_1">
          <mxGeometry x="40" y="20" width="1100" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_12" value="Exactement ce que Django a cree dans la base. &lt;b&gt;PK&lt;/b&gt; = cle primaire, &lt;b&gt;FK&lt;/b&gt; = cle etrangere, &lt;b&gt;UQ&lt;/b&gt; = unique. Le nom de table est entre parentheses." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;" vertex="1" parent="mpd_1">
          <mxGeometry x="40" y="56" width="1900" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_13" value="&lt;b&gt;HOTEL  (hotel)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  hotel_id          integer auto&lt;br&gt;    name             varchar(150)&lt;br&gt;    adresse          varchar(255)&lt;br&gt;    ville            varchar(100)&lt;br&gt;    tel              varchar(30)&lt;br&gt;    email            varchar(255)&lt;br&gt;    nombre_etages    integer  &amp;gt;= 1&lt;br&gt;    nombre_chambres  integer  &gt;= 0
heure_arrivee    time     defaut 15:00
heure_depart     time     defaut 11:00" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="50" y="110" width="315" height="162" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_14" value="&lt;b&gt;TYPE_DE_CHAMBRE  (type_de_chambre)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  id_type          integer auto&lt;br&gt;UQ  label            varchar(100)&lt;br&gt;    prix            decimal(10,2) &amp;gt;= 0&lt;br&gt;    capacite        integer  &amp;gt;= 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="50" y="298" width="315" height="102" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_15" value="&lt;b&gt;USER  (user)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  id_user        integer auto&lt;br&gt;UQ  username       varchar(150)&lt;br&gt;UQ  email          varchar(255)&lt;br&gt;    password       varchar(255) hache&lt;br&gt;    role           varchar(30)&lt;br&gt;                     admin|receptionniste|manager&lt;br&gt;FK  hotel_id       &amp;rarr; hotel.hotel_id   NULL&lt;br&gt;    (PROTECT) NULL si et seulement si&lt;br&gt;    is_superuser&lt;br&gt;    + herite de AbstractUser :&lt;br&gt;    is_superuser, is_staff, is_active,&lt;br&gt;    last_login, date_joined, first_name,&lt;br&gt;    last_name, groups, user_permissions&lt;br&gt;&lt;br&gt;CHECK user_hotel_ou_superuser :&lt;br&gt;    hotel_id NOT NULL  OU  is_superuser&lt;br&gt;La colonne est nullable, mais la contrainte&lt;br&gt;interdit tout compte orphelin. Seule&lt;br&gt;exception : le superadmin, cree avant&lt;br&gt;le premier hotel." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="50" y="426" width="315" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_16" value="&lt;b&gt;CHAMBRE  (chambre)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  id_chambre       integer auto&lt;br&gt;FK  hotel_id         &amp;rarr; hotel.hotel_id   NOT NULL&lt;br&gt;    (CASCADE)&lt;br&gt;FK  id_type          &amp;rarr; type_de_chambre.id_type&lt;br&gt;                         NOT NULL (PROTECT)&lt;br&gt;    numero           varchar(20)&lt;br&gt;    etage            integer  &amp;gt;= 0&lt;br&gt;    statut           varchar(20) defaut 'disponible'&lt;br&gt;UQ  (hotel_id, numero)&lt;br&gt;IDX (hotel_id, statut)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="420" y="110" width="315" height="192" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_17" value="&lt;b&gt;PERSONNEL  (personnel)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  matricule        integer auto&lt;br&gt;FK  id_user          &amp;rarr; user.id_user   NOT NULL UNIQUE&lt;br&gt;    (PROTECT â€” un employe EST un compte)&lt;br&gt;    sexe             char(1)  M|F&lt;br&gt;    poste            varchar(100)&lt;br&gt;IDX (poste)&lt;br&gt;&lt;br&gt;COLONNES SUPPRIMEES :&lt;br&gt;    nom, prenom  &amp;rarr; user.last_name,&lt;br&gt;                    user.first_name&lt;br&gt;    hotel_id     &amp;rarr; user.hotel&lt;br&gt;Elles vivaient en double et pouvaient se&lt;br&gt;contredire. Accessibles en Python comme&lt;br&gt;proprietes de lecture, plus en base." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="420" y="328" width="315" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_18" value="&lt;b&gt;CLIENT  (client)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  id_client        integer auto&lt;br&gt;    nom              varchar(100)&lt;br&gt;    prenom           varchar(100)&lt;br&gt;    tel              varchar(30)&lt;br&gt;    email            varchar(255)&lt;br&gt;                         indexe, NON unique&lt;br&gt;    document         varchar(255) vide ok&lt;br&gt;    preference       varchar(255) vide ok&lt;br&gt;    sexe             char(1)  M|F&lt;br&gt;    loyalty          boolean  defaut false&lt;br&gt;IDX (nom, prenom)&lt;br&gt;  &lt;i&gt;aucun password : ne se connecte pas&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="420" y="600" width="315" height="222" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_19" value="&lt;b&gt;DEMANDE  (demande)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  num integer auto&lt;br&gt;FK  hotel_id &amp;rarr; hotel.hotel_id NOT NULL (PROTECT)&lt;br&gt;FK  id_client &amp;rarr; client.id_client NOT NULL (PROTECT)&lt;br&gt;FK  chambre_demandee_id &amp;rarr; chambre.id_chambre NULL&lt;br&gt;    (SET_NULL) choix du client&lt;br&gt;PAS DE CHAMBRE ATTRIBUEE :&lt;br&gt;    une demande ne bloque aucune chambre&lt;br&gt;date_debut timestamp NOT NULL&lt;br&gt;date_fin timestamp NOT NULL&lt;br&gt;statut varchar(20) defaut 'en_attente'&lt;br&gt;    en_attente | acceptee | refusee&lt;br&gt;nombreDePersonne integer &amp;ge; 1&lt;br&gt;date_decision timestamp NULL&lt;br&gt;motif_refus varchar(255)&lt;br&gt;created_at timestamp defaut now&lt;br&gt;updated_at timestamp auto&lt;br&gt;IDX (statut, date_debut)&lt;br&gt;IDX (date_debut, date_fin)&lt;br&gt;tri par defaut : date_debut" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="790" y="110" width="365" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_26" value="&lt;b&gt;RESERVATION  (reservation)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  num integer auto&lt;br&gt;FK  hotel_id &amp;rarr; hotel.hotel_id NOT NULL (PROTECT)&lt;br&gt;FK  id_client &amp;rarr; client.id_client NOT NULL (PROTECT)&lt;br&gt;FK  id_chambre &amp;rarr; chambre.id_chambre NOT NULL (PROTECT)&lt;br&gt;    structurellement : pas de reservation&lt;br&gt;    sans chambre, sans CHECK supplementaire&lt;br&gt;FK  demande_id &amp;rarr; demande.num NULL&lt;br&gt;    (SET_NULL) tracabilite ; vide si saisie&lt;br&gt;    directe par un agent&lt;br&gt;date_debut timestamp NOT NULL&lt;br&gt;date_fin timestamp NOT NULL&lt;br&gt;statut varchar(20) defaut 'confirmee'&lt;br&gt;    confirmee | terminee | annulee&lt;br&gt;nombreDePersonne integer &amp;ge; 1&lt;br&gt;created_at timestamp defaut now&lt;br&gt;updated_at timestamp auto&lt;br&gt;IDX (statut, date_debut)&lt;br&gt;IDX (date_debut, date_fin)&lt;br&gt;tri par defaut : -date_debut" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="790" y="545" width="365" height="355" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_20" value="&lt;b&gt;NOTIFICATION  (notification)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  id_notif integer auto&lt;br&gt;FK  id_user &amp;rarr; user.id_user NOT NULL (CASCADE)&lt;br&gt;    title           varchar(150)&lt;br&gt;    detail          text&lt;br&gt;    action          varchar(150) vide ok&lt;br&gt;    lu              boolean defaut false&lt;br&gt;    created_at      timestamp auto_now_add&lt;br&gt;IDX (id_user, lu)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="1200" y="110" width="300" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_21" value="&lt;b&gt;SYNC_CURSOR  (sync_cursor)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  id integer auto&lt;br&gt;FK  hotel_id &amp;rarr; hotel.hotel_id NOT NULL&lt;br&gt;    appareil            varchar(64)&lt;br&gt;    derniere_consultation timestamp NULL&lt;br&gt;    nombre_appels       integer defaut 0&lt;br&gt;    mis_a_jour          timestamp auto&lt;br&gt;UQ (hotel_id, appareil)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="1200" y="345" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_22" value="&lt;b&gt;SYNC_JOURNAL  (sync_journal)&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;PK  id integer auto&lt;br&gt;FK  hotel_id &amp;rarr; hotel.hotel_id NOT NULL&lt;br&gt;FK  demande_id &amp;rarr; demande.num NOT NULL&lt;br&gt;    (CASCADE) â€” suit la DEMANDE, pas la&lt;br&gt;    reservation : c'est la demande que&lt;br&gt;    l'agent traite, meme s'il refuse.&lt;br&gt;    appareil            varchar(64) vide ok&lt;br&gt;    action             varchar(40)&lt;br&gt;    succes             boolean defaut true&lt;br&gt;    detail             text vide ok&lt;br&gt;    horodatage         timestamp auto_now_add&lt;br&gt;IDX (hotel_id, horodatage)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#444444;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="mpd_1">
          <mxGeometry x="1200" y="550" width="300" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_23" value="&lt;b&gt;&lt;font size='12'&gt;Regles appliquees 2 fois&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;Chaque regle existe en &lt;b&gt;CheckConstraint&lt;/b&gt; (garantie par la base, meme en INSERT SQL brut) &lt;b&gt;et&lt;/b&gt; en &lt;b&gt;clean()&lt;/b&gt; (message lisible, appele par save() et par les serializers DRF).&lt;br&gt;&lt;b&gt;demande_fin_apres_debut&lt;/b&gt; â€” fin &amp;gt; debut&lt;br&gt;&lt;b&gt;demande_min_une_personne&lt;/b&gt; â€” nombreDePersonne &amp;ge; 1&lt;br&gt;&lt;b&gt;reservation_fin_apres_debut&lt;/b&gt; â€” fin &amp;gt; debut&lt;br&gt;&lt;b&gt;reservation_min_une_personne&lt;/b&gt; â€” nombreDePersonne &amp;ge; 1&lt;br&gt;&lt;b&gt;user_hotel_ou_superuser&lt;/b&gt; â€” hotel ou admin plateforme&lt;br&gt;&lt;b&gt;chambre etage &amp;le; hotel nombre_etages&lt;/b&gt;&lt;br&gt;L'ancienne regle &lt;b&gt;reservation_confirmee_avec_chambre&lt;/b&gt; a disparu : id_chambre est desormais NOT NULL pour tout le monde." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="mpd_1">
          <mxGeometry x="1550" y="110" width="480" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_24" value="&lt;b&gt;&lt;font size='12'&gt;Sens des suppressions&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;&lt;b&gt;CASCADE&lt;/b&gt; â€” l'entite fille disparait avec la mere.&lt;br&gt;Â Â chambre, notification, journal&lt;br&gt;&lt;b&gt;PROTECT&lt;/b&gt; â€” suppression &lt;b&gt;refusee&lt;/b&gt; tant qu'il reste une reference. Protege l'historique et les reservations.&lt;br&gt;Â Â user (donc personnel), chambre attribuee,&lt;br&gt;Â Â client, hotel, demande, reservation&lt;br&gt;&lt;b&gt;SET_NULL&lt;/b&gt; â€” la FK passe a NULL, la ligne survit.&lt;br&gt;Â Â chambre demandee, reservation.demande&lt;br&gt;&lt;br&gt;Les 2 bases : toutes ces tables sont dans &lt;b&gt;DATABASE 1&lt;/b&gt; (cote API, la source de verite). &lt;b&gt;DATABASE 2&lt;/b&gt; (locale, cote logiciel desktop) ne contient que le cache de la file d'attente. Aucune de ces tables n'y existe." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="mpd_1">
          <mxGeometry x="1550" y="465" width="480" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="mpd_25" value="&lt;b&gt;&lt;font size='13'&gt;2 pieges a connaÃ®tre&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;&lt;b&gt;1. La table s'appelle &lt;code&gt;user&lt;/code&gt;&lt;/b&gt; â€” un mot reserve en PostgreSQL. Ca marche en SQLite (developpement) mais devra etre guillemet ou renomme au passage sur alwaysdata.&lt;br&gt;&lt;b&gt;2. nombre_chambres est trompeur&lt;/b&gt; â€” c'est une valeur saisie a la creation de l'hotel, pas un calcul. Pour le vrai nombre, utiliser &lt;code&gt;Hotel.chambres.count()&lt;/code&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="mpd_1">
          <mxGeometry x="1550" y="900" width="480" height="240" as="geometry"/>
        </mxCell>
