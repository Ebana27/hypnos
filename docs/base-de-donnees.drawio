        <mxCell id="mcd_15" value="&lt;b&gt;HOTEL&lt;/b&gt;&lt;br&gt;&lt;font color='#999999'&gt;â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€&lt;/font&gt;&lt;br&gt;hotel_id&lt;br&gt;name&lt;br&gt;adresse&lt;br&gt;ville&lt;br&gt;tel&lt;br&gt;email&lt;br&gt;nombre_etages&lt;br&gt;nombre_chambres&lt;br&gt;heures ref.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="mcd_1">
