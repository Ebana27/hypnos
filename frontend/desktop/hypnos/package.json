{
  "name": "hypnos",
  "version": "1.0.0",
  "description": "Une application Electron avec React destinée à la gestion d'un hôtel",
  "main": "./out/main/index.js",
  "author": "hypnos.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.hypnos.app",
    "productName": "Hypnos",
    "compression": "maximum",
    "electronLanguages": ["fr", "en-US"],
    "files": ["out/**/*", "resources/**/*"],
    "asarUnpack": ["resources/**", "node_modules/@libsql/**"],
    "extraResources": [{ "from": "drizzle", "to": "drizzle" }],
    "win": {
      "icon": "./resources/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "publish": [
      { "provider": "github", "owner": "Ebana27", "repo": "hypnos-update-history", "releaseType": "release" }
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.66.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron/rebuild": "^4.2.1",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.11",
    "electron": "^39.2.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.9.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.4",
    "vite": "^7.2.6"
  }
}